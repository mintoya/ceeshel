// a list given a type with as builds that type
@using @import @path "lib/types.cshl";
P ~~ @struct{ x ~i32; y ~i32; };
p ~= [1 as i32, 2 as i32] as P;
a ~= [3 as i32, 4 as i32, 5 as i32] as @arr[3, i32];
t ~= { [6 as i32, 7 as i32] as P };
(p.y == (2 as i32)) and (@get[a, 2] == (5 as i32)) and (t.x == (6 as i32))
