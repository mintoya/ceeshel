// calls are special: c(n) calls c's () member
i32 ~~ @sint();
Counter ~~ @struct{
  Self ~~ @this();
  n ~i32;
  @id("()") ~~ @fn[[self ~@refT(Self), by ~i32], i32, {
    self.n = self.n + by;
    self.n
  }];
};
c ~Counter = ([0 as i32] as Counter);
c(5 as i32);
c[2 as i32];
(c(3 as i32) == (10 as i32)) and (c.n == (10 as i32))
