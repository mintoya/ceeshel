// Runtime indexing through a reference, with iteration expressed by a loop.
i32 ~~ @sint();
A ~~ @arr[4, i32];
a ~A = ([3 as i32, 1 as i32, 4 as i32, 1 as i32] as A);
sum ~~ @fn[[a ~@refT(A)], i32, {
  i ~i32 = 0 as i32;
  total ~i32 = 0 as i32;
  @loop @if[i < (@len[a] as i32), {
    total = total + @get[a, i];
    i = i + (1 as i32);
    @repeat()
  }, total]
}];
sum(a) == (9 as i32)
