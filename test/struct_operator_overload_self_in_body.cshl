type ~~ @type();
vec2 ~type~ @struct{
  Self ~type~ @this();
  x ~ @sint(32);
  y ~ @sint(32);
  @id("+") ~~ @fn (self~Self,other~Self),Self,{
    r ~Self;
    r.x = self.x + other.x;
    r.y = self.y + other.y;
    return r;
  };
};
a ~vec2; a.x = 1; a.y = 2;
b ~vec2; b.x = 3; b.y = 4;
c ~vec2~ a + b;
c.x + c.y == 10;
