type ~~ @type();
s3 ~~ @sint(3);
s5 ~~ @sint(5);
u9 ~~ @uint(9);
u17 ~~ @uint(17);

a ~s3 = 3;
b ~s5 = 10;
c ~u9 = 400;
e ~u17 = 1000;

// the wider operand's width and signedness are kept when the widths differ
(@typeof(a + b) == s5) and ((a + b) == 13)
  and (@typeof(b * a) == s5) and ((b * a) == 30)
  and (@typeof(c + a) == u9) and ((c + a) == 403)
  and (@typeof(e + c) == u17) and ((e + c) == 1400)
  and (@typeof(c band e) == u17);
