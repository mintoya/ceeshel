type ~~ @type();
u32 ~~ @uint(32);

// 20 bit members do not sit on byte boundaries, so a member is read and written
// through more than one byte
B ~type~ @bitstruct{
  a ~u32:20;
  b ~u32:20;
};

x ~B;
x.a = 0xabcde;
x.b = 0x12345;

// rewriting the upper member leaves the lower one, which shares its middle byte, alone
y ~B;
y.a = 0xfffff;
y.b = 0x11111;
y.b = 0x0000f;

(x.a == 0xabcde)
  and (x.b == 0x12345)
  and (y.a == 0xfffff)
  and (y.b == 0x0000f)
  and (@sizeof(B) == 5);
