i32 ~~ @sint(32);
ast ~~ @ast();
inline ~~ @inlineast();
fn ~~ @fn (a~ast), inline, {
  return @qot @fn(@uqot(a."()".opleft),
    @uqot(a."()".opright."()".opleft),
    @uqot(a."()".opright."()".opright));
};
BoolRef ~~ @refT(@bool());
flag ~@bool() = 1;
Box ~~ @struct {
  Self ~~ @this();
  value ~i32;
  @id("==") ~~ fn (left~Self, right~Self) BoolRef return @ref(flag);
};
a ~Box;
(@compiles(a == a) == (0 as @bool()));
