@using @import @path "enumlib/module.cshl";
{

array_len ~~ fn (T~type) int return @typeinfo(T).array.len;

arrcat ~~ fn (a~any, b~any) any {
    fl ~~ array_len(@typeof(a)) + array_len(@typeof(b));
    r ~ @comptime arr(fl) @typeinfo(@typeof(a)).array.elem;
    {
        i~=0;
        cwhile (i < array_len(@typeof(a))) {
            r[i] = a[i];
            i = i + 1;
        };
    };
    {
        i~=0;
        cwhile (i < array_len(@typeof(b))) {
            r[i + array_len(@typeof(a))] = b[i];
            i = i + 1;
        };
    };
    return r;
};

int_str_rec ~~ fn (i~int) any {
    cif i == 0 {
        return "";
    } else {
        f ~ @comptime arr(1) i8;
        f[0] = (i % 10) + "0"[0];
        return arrcat(int_str_rec(i / 10), f);
    };
};

int_str ~~ fn (i~int) any {
    cif i < 0 {
        return arrcat("-", int_str_rec(i * -1));
    } else cif i == 0 {
        return "0";
    } else return int_str_rec(i);
};

negative ~~ int_str(-123);
positive ~~ int_str(456);
zero ~~ int_str(0);
(array_len(@typeof(negative)) == 4)
  and (negative[0] == "-"[0])
  and (negative[1] == "1"[0])
  and (negative[2] == "2"[0])
  and (negative[3] == "3"[0])
  and (array_len(@typeof(positive)) == 3)
  and (positive[0] == "4"[0])
  and (positive[1] == "5"[0])
  and (positive[2] == "6"[0])
  and (array_len(@typeof(zero)) == 1)
  and (zero[0] == "0"[0]);

};
