@using @import @path "enumlib/module.cshl";
f ~~ fn (width~int, value~@uint(width)) (@uint(width)) return value + 1;
selected ~~ specialize(f(5, 0));
p ~@fnptr((@uint(5)), @uint(5)) = selected;
(p(30) == 31) and (p(31) == 0) and
not(@compiles(@specialize(f(0, 0)))) and
not(@compiles(@specialize(f(-1, 0))));
