type ~~ @type();
s16 ~~ @sint(16);
u16 ~~ @uint(16);
s64 ~~ @sint(64);

// the base type only says how a member is read, the widths decide the layout, so mixing signed
// and unsigned members changes nothing about the size
mixed ~type~ @bitstruct{
  a ~s16:12;
  b ~u16:12;
  c ~s16:12;
  d ~u16:12;
  e ~s16:12;
  f ~u16:12;
};
// and neither does widening every base type: 72 bits is 9 bytes either way
wide ~type~ @bitstruct{
  a ~s64:12;
  b ~s64:12;
  c ~s64:12;
  d ~s64:12;
  e ~s64:12;
  f ~s64:12;
};

(@sizeof(mixed) == 9)
  and (@alignof(mixed) == 9)
  and (@sizeof(wide) == 9)
  and (@alignof(wide) == 9);
