i32 ~~ @sint(32);
ast ~~ @ast();
inline ~~ @inlineast();
fn ~~ @fn (a~ast), inline, {
  return @qot @fn(@uqot(a."()".opleft),
    @uqot(a."()".opright."()".opleft),
    @uqot(a."()".opright."()".opright));
};
effects ~i32 = 0;
Target ~~ @struct {
  value ~i32;
  @id("=") ~~ fn (self~ast, other~ast) inline {
    return @qot {
      effects = effects + 1;
      @uqot(self).value = @uqot(other) + 3;
    };
  };
};
next ~~ fn () i32 { effects = effects + 10; return 7; };
consume ~~ fn (input~Target) i32 return input.value;
observed ~= consume(next());
(observed == 10) and (effects == 11);
