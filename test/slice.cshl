// a slice of an array writes through to it; sub and iter
@using @import @path "lib/slice.cshl";
@using @import @path "lib/iterator.cshl";
@using @import @path "lib/types.cshl";
a ~@arr[5, i32] = ([1 as i32, 2 as i32, 3 as i32, 4 as i32, 5 as i32] as @arr[5, i32]);
s ~= slice_of(a);
s:get(0 as u64) = 10 as i32;
t ~= s:sub(1 as u64, 4 as u64);
t:get(2 as u64) = 40 as i32;
sum ~i32 = 0 as i32;
t:iter() |> each(sum = sum + _);
(@get[a, 0] == (10 as i32)) and (@get[a, 3] == (40 as i32)) and (t.len == (3 as u64)) and (sum == (45 as i32))
