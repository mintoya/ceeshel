@cinclude "stdio.h";
i32 ~~ @sint(32);
count ~i32 = 0;
mark ~~ @fn((n ~i32), @void(), {
  count = count + n;
  @cout "printf(\"body%i\\n\", arg0);";
});
mark(1);
@if(count == 1, { @cout "printf(\"cond\\n\");"; });
@if(count == 0, { @cout "printf(\"never\\n\");"; });
@cout "printf(\"after\\n\");";
count == 1;
