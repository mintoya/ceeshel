@using @import @path "enumlib/module.cshl";
@using @import @path "enumlib/iterator.cshl";
@using @import @path "enumlib/slice.cshl";

values ~arr(4) i32;
values[0] = 1;
values[1] = 2;
values[2] = 3;
values[3] = 4;
view ~slice(i32) = values;
it ~= view:iter();
// The yielded optional contains a reference, not a copied element.
it |> each { _ = _ * 10; };
view[1] = 25;
(values[0] == 10) and (values[1] == 25)
  and (values[2] == 30) and (values[3] == 40)
  and (view.len == 4) and (view:size() == 16) and not(it:next());
