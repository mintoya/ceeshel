// Build a pointer field for each source field using a compile-time loop.
i32 ~~ @sint(); u8 ~~ @uint(); int ~~ @int(); ast ~~ @ast(); type ~~ @type();
Ptrs ~~ @fn[[T ~type], type, {
  x ~@comptime(T);
  i ~int = 0;
  fields ~ast = '{};
  @loop @if[i < @countof(T), {
    name ~~ @fieldname(T, i);
    fields = '{ ..`(@get[fields, 1, @len[fields]]); `name ~@ptr(@typeof(x.`name)); };
    i = i + 1;
    @repeat()
  }];
  @struct `fields
}];
P ~~ @struct{ a ~i32; b ~u8; };
Q ~~ Ptrs(P);
p ~P = ([1 as i32, 2 as u8] as P);
q ~Q = ([@where p.a, @where p.b] as Q);
@at q.a = 10 as i32;
(@countof(Q) == 2) and (@fieldtype(Q, 1) == @ptr(u8))
  and @ast_stringeq(@fieldname(Q, 0), "a") and (p.a == (10 as i32)) and ((@at q.b) == (2 as u8))
