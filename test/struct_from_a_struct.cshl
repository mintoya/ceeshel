// Build a pointer field for each source field using compile-time recurrence.
i32 ~~ @sint(); u8 ~~ @uint(); int ~~ @int(); ast ~~ @ast(); type ~~ @type();
Ptrs ~~ @fn[[T ~type], type, {
  x ~@comptime(T);
  fields ~~ @fn[[i ~int, fields ~ast], ast, {
    @if[i < @countof(T), {
      name ~~ @fieldname(T, i);
      @recur[i + 1, `('{ ..`(@get[fields, 1, @len[fields]]); `name ~@ptr(@typeof(x.`name)); })];
    }];
    fields
  }](0, {});
  @struct `fields
}];
P ~~ @struct{ a ~i32; b ~u8; };
Q ~~ Ptrs(P);
p ~P = ([1 as i32, 2 as u8] as P);
q ~Q = ([@where p.a, @where p.b] as Q);
@at q.a = 10 as i32;
(@countof(Q) == 2) and (@fieldtype(Q, 1) == @ptr(u8))
  and @ast_stringeq(@fieldname(Q, 0), "a") and (p.a == (10 as i32)) and ((@at q.b) == (2 as u8))
