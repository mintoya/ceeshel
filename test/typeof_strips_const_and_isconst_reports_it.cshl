i32 ~~ @sint(32);
mutable ~i32 = 5;
constant ~i32~ 7;
qualified ~@const(i32) = 9;
both ~@const(@comptime(i32)) = 11;
copy ~@typeof(constant) = constant;
copy = 13;
(@typeof(constant) == i32)
  and (@typeof(qualified) == i32)
  and (@typeof(both) == i32)
  and @isconst(constant)
  and @isconst(qualified)
  and @isconst(both)
  and @iscomptime(both)
  and @if(@isconst(mutable), 0, 1)
  and @if(@isconst(copy), 0, 1)
  and (copy == 13)
  and (constant == 7);
