@cinclude "stdio.h";

bool ~~ @bool();
true ~@comptime(bool)~ 1;
false ~@comptime(bool)~ 0;

// `and` decides on the left, so its right-hand block must not run.
flag ~bool = false;
flag and {
  @cout "printf(\"and ran\\n\");";
  true;
};

// `or` has to run its right-hand block when the left is false.
flag or {
  @cout "printf(\"or ran\\n\");";
  false;
};

@cout "printf(\"done\\n\");";
true;
