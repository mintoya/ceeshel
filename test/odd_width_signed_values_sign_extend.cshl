type ~~ @type();
s3 ~~ @sint(3);

one ~s3 = 0 - 1;
min ~s3 = 0 - 4;
pos ~s3 = 3;

// the top bit is the sign, arithmetic wraps at three bits and reads back signed
((one == (0 - 1)))
  and ((min == (0 - 4)))
  and ((one + one) == (0 - 2))
  and ((min - 1) == 3)
  and ((min + min) == 0)
  and ((pos + one) == 2)
  and ((one bxor pos) == (0 - 4));
