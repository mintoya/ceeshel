// A compile-time linked list with heterogeneous exports and a linear scan.
empty ~~ @struct{};
push ~~ @fn((tail ~@type(), key ~@any(), value ~@type()), @type(), {
  return @struct { next ~~ tail; key ~~ key; value ~~ value; };
});
same ~~ @fn((a ~@any(), b ~@any(), i ~@int()), @comptime(@bool()), {
  @cif(i == @typeinfo(@typeof(a)).array.len, { return 1; }, {
    @cif(a[i] != b[i], { return 0; }, { return same(a, b, i + 1); });
  });
});
find ~~ @fn((head ~@type(), key ~@any()), @type(), {
  @cif(@compiles(head.key), {
    @cif(@typeinfo(@typeof(head.key)).array.len == @typeinfo(@typeof(key)).array.len, {
      @cif(same(head.key, key, 0), { return head.value; }, {
        return find(head.next, key);
      });
    }, { return find(head.next, key); });
  }, { return empty; });
});
load ~~ @fn((head ~@type(), key ~@any()), @type(), {
  @cif(find(head, key) == empty, {
    return push(head, key, @import(key));
  }, { return head; });
});
path ~~ @path("module.cshl");
cache ~~ load(empty, path);
exports ~~ find(cache, path);
cache2 ~~ push(cache, "other", @struct { value ~~ 17; });
cache3 ~~ load(cache2, @path("./module.cshl"));
(cache3 == cache2) and (find(cache2, path) == exports)
  and (find(cache2, "other").value == 17) and (find(cache2, "missing") == empty);
