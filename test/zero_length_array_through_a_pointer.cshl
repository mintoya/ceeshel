// a zero-length array has its length elsewhere: made from a pointer to
// a[1], its element i is a[1 + i]. This is what slices are built on.
i32 ~~ @sint();
a ~@arr[4, i32] = ([10 as i32, 20 as i32, 30 as i32, 40 as i32] as @arr[4, i32]);
p ~@ptr(@arr[0, i32]) = (@where @get[a, 1]) as @ptr(@arr[0, i32]);
ra ~@refT(@arr[0, i32]) ~ @at(p);
@get[ra, 1] = 33 as i32;
(@get[ra, 0] == (20 as i32)) and (@get[ra, 2] == (40 as i32)) and (@get[a, 2] == (33 as i32))
