type ~~ @type();
u32 ~~ @uint(32);

f32 ~~ @struct{
  bits ~ @bitstruct{
    mantissa ~ u32:23;
    exponent ~ u32:8;
    sign     ~ u32:1;
  };
};

r ~ f32;
r.bits.mantissa = 5;
r.bits.exponent = 2;
r.bits.sign = 1;

(r.bits.mantissa == 5)
  and (r.bits.exponent == 2)
  and (r.bits.sign == 1)
  and (@sizeof(f32) == 4)
  and (@alignof(f32) == 4);
