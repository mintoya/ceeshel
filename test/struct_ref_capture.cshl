type ~~ @type();
s32 ~~ @sint(32);
counter ~s32 = 5;
cell ~type~ @struct{
  Self ~type~ @this();
  r ~ (@refT(s32));
  @id("()") ~~ @fn (self ~Self, j ~s32), s32, {
    v ~(@refT(s32)) = self.r;
    v = v + j;
    return v;
  };
};
make ~~ @fn (), cell, {
  c ~cell;
  c.r = @ref counter;
  return c;
};
result ~~ @fn (), s32, {
  k ~cell = make();
  k(2);
  return counter;
};
result() == 7;
