@using @import @path "enumlib/module.cshl";
@using @import @path "enumlib/slice.cshl";

Callback ~~ @fnptr(((@ptrof void), slice(i8)), void);
Context ~~ @struct { callback ~ Callback; };

make ~~ fn () Context {
  context ~ Context;
  context.callback = (fn ((@ptrof void), message~slice(i8)) void {});
  return context;
};

context ~ Context = make();
true;
