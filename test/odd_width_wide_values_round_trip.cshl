type ~~ @type();
u9 ~~ @uint(9);
u17 ~~ @uint(17);
u33 ~~ @uint(33);
u65 ~~ @uint(65);

a ~u9 = 500;
b ~u17 = 70000;
c ~u33 = 4000000000;
d ~u65 = 18446744073709551616;

// odd widths past one byte keep their full value through math, shifts and casts
((a + 12) == 0)
  and ((b + 1000) == 71000)
  and ((b shr 1) == 35000)
  and ((c * 2) == 8000000000)
  and ((d + 1) == 18446744073709551617)
  and ((a as u17) == 500)
  and ((b as u9) == 368);
