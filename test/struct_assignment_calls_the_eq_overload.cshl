// = is a name: this one sends x = v and x ~T = v to x's __set when that
// compiles, and assigns as the builtin does otherwise
u32 ~~ @uint(); any ~~ @any();
split ~~ @struct{
  Self ~~ @this();
  lo ~u32;
  hi ~u32;
  writes ~u32;
  __set ~~ @fn[[this ~@refT(Self), val ~u32], @void(), {
    this.writes = this.writes + (1 as u32);
    this.lo = val band (65535 as u32);
    this.hi = (val shr (16 as u32)) band (65535 as u32);
  }];
  whole ~~ @fn[[this ~Self], u32, this.lo bor (this.hi shl (16 as u32))];
};
@id("=") ~~ @fn[[target ~@refT(any), value ~any], @void(),
  { @raw(@if[@compiles(target:__set(value)), target:__set(value), target = value]); }];
pair ~~ @struct{ first ~split; second ~split; };
a ~split;
a = 16909060 as u32;
b ~pair;
b.second = 3232235777 as u32;
d ~split;
d = 9 as u32;
e ~split = d;
c ~split = 66051 as u32;
(a:whole() == (16909060 as u32)) and (b.second:whole() == (3232235777 as u32)) and (b.first:whole() == (0 as u32))
  and (d:whole() == (9 as u32)) and (e:whole() == (9 as u32)) and (c:whole() == (66051 as u32)) and ((a.writes + b.second.writes + c.writes + d.writes) == (4 as u32))
