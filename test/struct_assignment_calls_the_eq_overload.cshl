type ~~ @type();
u32 ~~ @uint(32);
void ~~ @void();

writes ~ u32;
writes = 0;

split ~~ @struct{
  Self ~type~ @this();
  bits ~ @struct{
    lo ~ u32;
    hi ~ u32;
  };
  @id("=") ~~ @fn (this ~@refT(Self), val ~u32), @void(), {
    writes = writes + 1;
    this.bits.lo = val band 65535;
    this.bits.hi = (val shr 16) band 65535;
  };
  @id("as") ~~ @fn (this ~Self, target ~type), u32, {
    return this.bits.lo bor (this.bits.hi shl 16);
  };
};

pair ~~ @struct{
  Self ~type~ @this();
  first ~ split;
  second ~ split;
};

a ~ split;
a = 16909060;
b ~ pair;
b.second = 3232235777;
c ~ split = 66051;
d ~ split;
d = 9;
k ~ split ~ d;
m ~ split ~ (d as u32);

((a as u32) == 16909060)
  and ((b.second as u32) == 3232235777)
  and ((b.first as u32) == 0)
  and ((c as u32) == 66051)
  and ((d as u32) == 9)
  and ((k as u32) == 9)
  and ((m as u32) == 9)
  // a, b.second, c, d, k, and m each invoke assignment.
  and (writes == 6);
