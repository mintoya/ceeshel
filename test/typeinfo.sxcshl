(~ i32 :const (@sint 32))
(= [(~ info) (@typeInfo i32)])

// typeinfo's tag is an array, the non used bytes are zeros
(~ infostr :const (@fn [(@any []) (@typeof (. [info tag])) {
  (~ [r (@returntype [])]) // zero initialization by default
  (= [(~ i :type i32) 0])
  (@loop {
    (@if [(>= [i (. [(. [(@typeinfo (@arg [])) array]) len])]) (@break [])])
    (= [((: [r get]) i) ((: [(@arg []) get]) i)])
    (= [i (+ [i 1])])
  })
  r
}]))

(== [(. [info tag]) (infostr "type")])
(~ i325 :const (@arr [5 i32]))

(= [info (@typeInfo i325)])
(== [(. [info tag]) (infostr "array")])

(== [(. [(. [info array]) member]) i32])
(== [(. [(. [info array]) len]) 5])
