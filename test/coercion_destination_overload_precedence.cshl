i32 ~~ @sint(32);
ast ~~ @ast();
inline ~~ @inlineast();
fn ~~ @fn (a~ast), inline, {
  return @qot @fn(@uqot(a."()".opleft),
    @uqot(a."()".opright."()".opleft),
    @uqot(a."()".opright."()".opright));
};
effects ~i32 = 0;
Source ~~ @struct {
  value ~i32;
  @id("as") ~~ fn (self~ast, target~@type()) inline return @qot(@compileError());
};
Target ~~ @struct {
  value ~i32;
  @id("=") ~~ fn (self~ast, other~ast) inline {
    return @qot {
      effects = effects + 1;
      @uqot(self).value = @uqot(other).value + 2;
    };
  };
};
a ~Source; a.value = 7;
b ~Target = a;
c ~= a as Target;
consume ~~ fn (input~Target) i32 return input.value;
produce ~~ fn () Target return a;
d ~= consume(a);
e ~= produce();
(b.value == 9) and (c.value == 9) and (d == 9) and (e.value == 9) and (effects == 4);
