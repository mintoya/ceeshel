i32 ~~ @sint(32);
ast ~~ @ast();
inline ~~ @inlineast();
fn ~~ @fn (a~ast), inline, {
  return @qot @fn(@uqot(a."()".opleft),
    @uqot(a."()".opright."()".opleft),
    @uqot(a."()".opright."()".opright));
};
effects ~i32 = 0;
Box ~~ @struct {
  value ~i32;
  @id("-") ~~ fn (left~ast, right~ast) inline {
    return @qot {
      effects = effects + 1;
      @uqot(left).value + @uqot(right);
    };
  };
};
a ~Box;
a.value = 11;
next ~~ fn () i32 {
  effects = effects + 10;
  return 7;
};
result ~= a - next();
(result == 18) and (effects == 11);
