// error: UNBOUND_ID
// an ast parameter is data: lowering it in the callee doesn't reach the
// caller's names (that is what an inline result is for)
i32 ~~ @sint(); ast ~~ @ast();
inc ~~ @fn[[v ~ast], @void(), `v = `v + (1 as i32)];
f ~~ @fn[[], i32, { x ~i32 = 1 as i32; inc(x); x }];
f() == (2 as i32)
