x ~@sint(32) = 7;
bad ~~ @fn (v ~@sint(32)), @sint(32), { return missing; };
good ~~ @fn (v ~@sint(32)), @sint(32), { return v + 1; };
@cif(@compiles(missing), { x = 99; });
@compiles(x + 1)
  and (@compiles(missing) == 0)
  and (@compiles(@at(x)) == 0)
  and @compiles({ x = 99; })
  and (@compiles(bad(x)) == 0)
  and (@compiles(bad(x)) == 0)
  and @compiles(good(x))
  and (good(x) == 8)
  and (x == 7);
