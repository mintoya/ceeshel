// Explicit arrays are passed as one argument; recur carries iteration state.
i32 ~~ @sint(); index ~~ @uint();
sum ~~ @fn[[xs ~@any(), i ~index = 0 as index, total ~i32 = 0 as i32], i32, {
  a ~@typeof(xs) = xs;
  @if[i < (@len[a] as index), @recur[xs, i + (1 as index), total + @get[a, i]]];
  total
}];
a ~i32 = 4 as i32;
(sum([1 as i32, 2 as i32, a] as @arr[3, i32]) == (7 as i32))
  and (sum([a, a] as @arr[2, i32]) == (8 as i32))
