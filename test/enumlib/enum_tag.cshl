@using @import @path "module.cshl";

// Match is expanded in the caller; reflection supplies generated variant names.
enum_tag_match ~~ fn (T~type) any {
  return fn (self~ast, arms~ast) inline {
  info ~~ @typeinfo(T.Variants).struct.members;
  receiver ~~ @gensym(receiver);
  count ~= 0;
  cwhile (arms[count]) { count = count + 1; };
  cif (count != info.len) @compileError();
  chain ~ast;
  i ~= count;
  cwhile (i > 0) {
    arm ~~ arms[i - 1];
    name ~~ arm.op."|>".opleft;
    body ~~ arm.op."|>".opright;
    cif (not(name.id) or not(body)) @compileError();
    j ~= 0;
    tag ~ast = @qot(0);
    cwhile (j < count and info[j].name != name) {
      j = j + 1;
      tag = @qot(@uqot(tag) + 1);
    };
    cif (j == count) @compileError();
    k ~= i;
    cwhile (k < count) {
      cif (arms[k].op."|>".opleft == name) @compileError();
      k = k + 1;
    };
    payload ~~ @ast_op(".", @ast_op(".", receiver, @qot(payload)), name);
    branch ~ast = body;
    cif (info[j].type != void) {
      branch = @qot(@uqot(payload) |> @uqot(body));
    };
    cif (i == count) { chain = branch; }
    else {
      chain = @qot @if(@uqot(receiver).tag == @uqot(tag), @uqot(branch), @uqot(chain));
    };
    i = i - 1;
  };
  return @qot {
    @uqot(receiver) ~= @uqot(self);
    @uqot(chain);
  };
  };
};

enum_tag ~~ fn (syntax~ast) inline {
  tag_type ~~ syntax."()".opleft;
  variants ~~ syntax."()".opright.ablock;
  cif (not(variants[0])) @compileError();
  index ~ast = @qot(0);
  make_field ~~ fn (variant~ast) ast {
    name ~~ variant.op.":".opleft;
    T ~~ variant.op.":".opright;
    cif (not(name.id) or not(T)) @compileError();

    return @qot(@uqot(name) ~@uqot(T));
  };
  make_constructor ~~ fn (variant~ast) ast {
    name ~~ variant.op.":".opleft;
    tag ~~ index;
    index = @qot(@uqot(index) + 1);
    return @qot(@uqot(name) ~~ fn (value~@typeinfo(Variants).struct.members[@uqot(tag)].type) Self {
      result ~Self;
      result.tag = @uqot(tag);
      cif (@typeof(value) != void) {
        @uqot(@ast_op(".", @qot(result.payload), name)) = value;
      };
      return result;
    });
  };
  fields ~~ @apply(make_field, variants);
  union_index ~ast = @qot(0);
  make_union_field ~~ fn (variant~ast) ast {
    name ~~ variant.op.":".opleft;
    tag ~~ union_index;
    union_index = @qot(@uqot(union_index) + 1);
    return @qot(@uqot(name) ~@typeinfo(Variants).struct.members[@uqot(tag)].type);
  };
  union_fields ~~ @apply(make_union_field, variants);
  constructors ~~ @apply(make_constructor, variants);
  return @qot @struct {
    Self ~~ @this();
    Variants ~~ @struct { @splice fields; };
    tag ~@uqot(tag_type);
    payload ~@union { @splice union_fields; };
    @splice constructors;
    match ~~ enum_tag_match(Self);
  };
};

@struct { enum_tag ~~ enum_tag; enum_tag_match ~~ enum_tag_match; };
