@using @import @path "module.cshl";
@using @import @path "iterator.cshl";

slice ~~ fn (t~type) type return @struct{
  Self ~~@this();
  RSelf ~~@reft @this();
  ptr ~ @ptrof(arr(0) t); 
  len ~ u64;

  size ~~ fn (self~Self) u64 return self.len * @sizeof(t);
  get ~~ fn (self~Self , idx ~u64) (@reft t) {
    ra ~@reft(arr(0) t)~ @ref @at(self.ptr);
    return @ref ra[idx];
  };
  @id("[]") ~~ fn (self~Self,idx~u64) (@reft t) return self:get(idx);

  @id("=") ~~ fn (self~RSelf, other~any) inline {
    cif (@typeof(other) == @typeof(self)) {
      self.ptr = other.ptr;
      self.len = other.len;
    } else cif (
      @typeinfo(@typeof(other)).array
      and (@typeinfo(@typeof(other)).array.elem == t)
    ) {
      self.ptr = (@where (other[0])) as @typeof(self.ptr);
      self.len = @typeinfo(@typeof(other)).array.len;
    } else @compileError();
  };
  sub ~~ fn (self~Self,start~u64, end~(? u64)) Self {
    result ~ Self;
    result.ptr = self.ptr;
    result.len =  end:orelse(self.len) - start;
    if (result.len > 0) {
      sp ~@ptrof(i8)~ @where(self:get(start));
      result.ptr = sp as @typeof(result.ptr);
    };
    // bounds check or something
    return result;
  };
  iter ~~ fn (self~Self) any {
    resT ~~ @struct{
      mem   ~Self;
      place ~u64;
      next  ~~ fn (self~(@reft @this())) (? @reft t) {
        if (self.place >= self.mem.len)
          return null;
        self.place = self.place + 1;
        return self.mem:get(self.place - 1);
      };
    };
    res ~resT;
    res.mem = self;
    return res;
  };
};

@struct{
  slice ~~ slice;
};
