@using @import @path "module.cshl";
@using @import @path "iterator.cshl";

slice ~~ fn (t~type) type return @struct{
  Self ~~@this();
  RSelf ~~@reft @this();
  ptr ~ @ptrof(arr(0) t); 
  len ~ u64;

  size ~~ fn (self~Self) u64 return self.len * @sizeof(t);
  get ~~ fn (self~Self , idx ~u64) (@reft t) {
    ra ~@reft(arr(0) t)~ @ref @at(self.ptr);
    return @ref ra[idx];
  };
  @id("=") ~~ fn (self~ast, other~ast) inline {
    source ~~ @gensym(source);
    return @qot {
      cif (@typeof(@uqot(other)) == @typeof(@uqot(self))) {
        @uqot(source) ~~ @uqot(other);
        @uqot(self).ptr = @uqot(source).ptr;
        @uqot(self).len = @uqot(source).len;
      } else cif (
        @typeinfo(@typeof(@uqot(other))).array
        and (@typeinfo(@typeof(@uqot(other))).array.elem == @typeof((@at @uqot(self).ptr)[0]))
      ) {
        @uqot(self).ptr = (@where @ref (@uqot(other))[0]) as @typeof(@uqot(self).ptr);
        @uqot(self).len = @typeinfo(@typeof(@uqot(other))).array.len;
      } else @compileError();
    };
  };
  @id("()") ~~ fn (self~ast,idx~ast) inline {
    cif (
        not(idx.ablock)
        or not(idx.ablock[0])
        or (idx.ablock[1])
        ) @compileError(); // not bound to anything, so error is unbound id 
    return @qot {
      this ~~ @uqot(self);
      idx_n ~u64~ @uqot(idx.ablock[0]);
      @ref this:get(idx_n);
    };
  };
  sub ~~ fn (self~Self,start~u64, end~(? u64)) Self {
    result ~ Self;
    result.ptr = self.ptr;
    result.len =  end:orelse(self.len) - start;
    if (result.len > 0) {
      sp ~@ptrof(i8)~ @where(self:get(start));
      result.ptr = sp as @typeof(result.ptr);
    };
    // bounds check or something
    return result;
  };
  iter ~~ fn (self~Self) any {
    resT ~~ @struct{
      mem   ~@typeof(self);
      place ~@typeof(self.len);
      next  ~~ fn (self~@reft @this()) (? @reft t) {
        if (self.place >= self.mem.len)
          return null;
        self.place = self.place + 1;
        return self.mem:get(self.place - 1);
      };
    };
    res ~resT;
    res.mem = self;
    return res;
  };
};

@struct{
  slice ~~ slice ;
};
