@using @import @path "module.cshl";
@using @import @path "slice.cshl";
@using @import @path "iterator.cshl";
@cinclude "<stdio.h>";

cputc ~~ fn  (char~i8) void @cout "putchar((char)arg0);";

fmt_ctx ~~ @struct {
  ctx ~(@ptrof void);
  out ~fnptr ((@ptrof void),slice(i8)) void;
  put ~~ fn (self~@this() , msg~slice(i8)) void 
    self.out(self.ctx,msg);
};

fmt_int ~~ fn (fmtctx~any,i~i64) void {
  if (i < 0) { i = -1 * i;};
  if (i == 0) fmtctx:put("0");
  j~i8=0;
  r ~ arr(40)i8;
  while (i) {
    r[j] = ("0"[0]) + (i % 10);
    i = i / 10;
    j = j + 1;
  };
  while (j) {
    a ~slice(i8);
    a.len = 1;
    a.ptr = ( @where r[j - 1] ) as @typeof(a.ptr);
    fmtctx:put(a);
    j = j - 1;
  };
};
fmt_r ~~ fn (
  fmtctx~any,
  str~any,
  fmtstruct~any,
) void {
  len ~~ @typeinfo(@typeof(str)).array.len;
  lindex ~= 0;
  nindex ~= 0;
  index ~= 0;
  cwhile (index < @typeinfo(@typeof(fmtstruct)).struct.members.len) {
    itname ~~ @typeinfo(@typeof(fmtstruct)).struct.members[index].name;
    item ~~ @uqot @qot @rawget(fmtstruct,@id(itname));
    cwhile (nindex < len and str[nindex] != "%"[0]) {
      cif (str[nindex] == "/"[0]) {
        fmtctx:put((str as slice(i8)):sub(lindex,nindex as u64));
        nindex = nindex + 1;
        cif (nindex >= len) { @compileError(); };
        lindex = nindex;
      };
      nindex = nindex + 1;
    };
    cif (nindex >= len) {@compileError();};
    fmtctx:put((str as slice(i8)):sub(lindex,nindex as u64));
    cif (@compiles(fmt_int(fmtctx,item))) {
      fmt_int(fmtctx,item);
    } else cif (@compiles(fmtctx:put(item))) {
      fmtctx:put(item);
    } else item:_fmt(fmtctx);
    index = index + 1;
    nindex = nindex + 1;
    lindex = nindex;
  };
  cwhile (nindex < len) {
    cif (str[nindex] == "/"[0]) {
      fmtctx:put((str as slice(i8)):sub(lindex,nindex as u64));
      nindex = nindex + 1;
      cif (nindex >= len) { @compileError(); };
      lindex = nindex;
    };
    nindex = nindex + 1;
  };
  fmtctx:put((str as slice(i8)):sub(lindex,len as u64));
};
n~=1;
fmt ~~ fn (a~ast) inline {
  itl ~ast~ a[2,@uqot@qot@ast_len(@uqot a)];
  st ~ast~ @gensym(st);
  s ~ast~ @gensym(s);
  gen_sg ~~ fn (a~ast) ast {
    //nam ~ast~ @id(int_str(n = n+1));
    nam ~ast~ @gensym(nam);
    @cif(a."()", {
      @cif(a."()".opleft.id == "@sizeof", {
        return @qot {
          return @qot [ @uqot(nam) ~ i64,
                        @uqot(@ast_op(".", s, nam)) = @uqot(a) ];
        };
      });
    });
    arg_type ~~ @typeof(@uqot(a));
    cif (@iscomptime(arg_type)) {
      return @qot {
        return @qot [ @uqot(nam) ~~ @uqot(a), {} ];
      };
    };
    return @qot {
      return @qot [ @uqot(nam) ~ @typeof(@uqot(a)),
                    @uqot(@ast_op(".", s, nam)) = @uqot(a) ];
    };
  };
  eval_arg     ~ast~ @gensym(arg);
  eval_name    ~ast~ @gensym(gen_sg);
  members_name ~ast~ @gensym(member_ast);
  member_name  ~ast~ @gensym(gen_member);
  assig_name   ~ast~ @gensym(gen_assig);
  eval_body    ~ast~ @ast_op("()", @qot(@uqot), eval_arg);
  eval_fn      ~ast~ @qot fn (@uqot(eval_arg)~ast) ast @uqot(eval_body);
  computations ~ast~ @apply(gen_sg,itl);
  quoted_computations ~ast~ @qot @qot [@splice computations];
  member_splice ~ast= @qot @apply(@uqot(member_name),@uqot(members_name));
  member_splice = @ast_op("()", @qot(@splice), member_splice);
  assig_splice ~ast= @qot @apply(@uqot(assig_name),@uqot(members_name));
  assig_splice = @ast_op("()", @qot(@splice), assig_splice);
  result ~ast= @qot @qot {
    @uqot(st) ~~ @struct { @uqot(member_splice); };
    @uqot(s) ~ @uqot(st);
    @uqot(assig_splice);
    @uqot(s);
  };
  result = {@ast_op("()", @qot(@uqot), result);};
  return @qot fmt_r(
      (@ref @uqot(a[0])),
      @uqot(a[1]),
      {
        @uqot(eval_name) ~~ @uqot(eval_fn);
        @uqot(members_name) ~ast~ @apply(@uqot(eval_name),@uqot(quoted_computations));
        @uqot(member_name) ~~ fn (a~ast) ast return a[0];
        @uqot(assig_name) ~~ fn (a~ast) ast return a[1];
        @uqot(result);
      }
  );
};

cfmt ~~ fn () fmt_ctx {
  cmt ~fmt_ctx;
  cmt.out  =
    (fn ((@ptrof void),msg~slice(i8)) void
        (msg:iter() |> each cputc _));
  return cmt;
};

print ~~ fn (a ~ ast) inline
  return @qot fmt (cfmt(),@splice(a));

/*
print["% != %%", 1, 23 , "\n"];
*/



@struct {
  cfmt ~~ cfmt;
  fmt ~~ fmt;
  fmt_r ~~ fmt_r;
  fmt_ctx ~~ fmt_ctx;
  print ~~ print;
};
