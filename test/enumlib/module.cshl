type ~~ @type();
ast  ~~ @ast();
any  ~~ @any();
int ~~ @int();
inline ~~ @inlineast();
i8  ~~ @sint 8;
i16 ~~ @sint 16;
i32 ~~ @sint 32;
i64 ~~ @sint 64;
u8  ~~ @uint 8;
u16 ~~ @uint 16;
u32 ~~ @uint 32;
u64 ~~ @uint 64;
bool ~~ @bool();
true ~@comptime(bool)~1;
false~@comptime(bool)~0;
null ~@comptime(@struct{});
void ~~ @void();

@ast_len ~~ @fn (a~ast),int,{
  result ~=0;
  @cwhile(a[result], result = result + 1);
  return result;
};
fn  ~~ @fn (a ~ast),inline,(return @qot @fn(
  @uqot(a."()".opleft),
  @uqot(a."()".opright."()".opleft),
  @uqot(a."()".opright."()".opright),
));
fnptr  ~~ @fn (a ~ast),inline,(return @qot @fnptr(
  @uqot(a."()".opleft),
  @uqot(a."()".opright),
));

@closure ~~ @fn (caps ~ast, args ~ast, ret ~ast, body ~ast),@inlineast(),{
  make_structItem ~~ @fn (in~ast),ast,{
   @cif(in.decl, {
      @cif(not(in.decl.value),@compileError());
      @cif(not(in.decl.name),@compileError());
      atype ~ast;
      @cif(in.decl.type,
        atype = in.decl.type,
        atype = @qot(@reft @typeof @uqot(in.decl.value)),
      );
      return @qot(@uqot(in.decl.name)~@uqot(atype));
   }, @cif(in.id, {
        atype ~ast~ @qot(@reft @typeof @uqot(in.id));
        return @qot(@uqot(in)~@uqot(atype));
   },@compileError()));
  };
  retrieve_structItem ~~ @fn (in~ast),ast,{
   aname ~ast;
   @cif(in.decl, {
     aname = in.name;
   }, @cif(in.id, {
     aname = in.id;
   },@compileError()));
   return @qot(@uqot(aname) ~= @uqot(@ast_op(".", @qot(self), aname)));
  };
  set_structItem ~~ @fn (in~ast),ast,{
   aname ~ast;
   oname ~ast;
   @cif(in.decl, {
     aname = in.name;
     oname = in.value;
   }, @cif(in.id, {
     aname = in.id;
     oname = aname;
   },@compileError()));
   return @ast_op( "=",
     @ast_op(".", @qot(result), aname),
     oname
   );
  };
  return @qot {
    result ~ @uqot @qot @struct {
      Self~~@this();
      @splice @apply(make_structItem,caps);
      @id("()") ~~ @fn(
        (self ~Self,@splice(args)),
        @uqot(ret), {
          @splice @apply(retrieve_structItem,caps);
          @uqot(body);
        });
    };
    @splice @apply(set_structItem,caps);
    result;
  };
};
closure ~~ fn (a ~ast) inline {
  return 
    @qot @closure(
      @uqot(a."()".opleft),
      @uqot(a."()".opright."()".opleft),
      @uqot(a."()".opright."()".opright."()".opleft),
      @uqot(a."()".opright."()".opright."()".opright),
    );
};
if  ~~ fn (a ~ast) inline {
  call ~ast~ a."()";
  cond ~ast~ call.opleft;
  rest ~ast~ call.opright;

  @cif((rest."()".opright."()".opleft == "else"), {
    then ~ast~ rest.opleft;
    else ~ast~ rest.opright."()".opright;

    return @qot @if(
      @uqot(cond),
      @uqot(then),
      @uqot(else)
    );
  });

  return @qot @if(
    @uqot(cond),
    @uqot(rest)
  );
};
cif  ~~ fn (a ~ast) inline {
  call ~ast~ a."()";
  cond ~ast~ call.opleft;
  rest ~ast~ call.opright;

  @cif((rest."()".opright."()".opleft == "else"), {
    then ~ast~ rest.opleft;
    else ~ast~ rest.opright."()".opright;

    return @qot @cif(
      @uqot(cond),
      @uqot(then),
      @uqot(else)
    );
  });

  return @qot @cif(
    @uqot(cond),
    @uqot(rest)
  );
};
cwhile ~~ fn (a ~ast) inline {
  cond ~ast~ a."()".opleft;
  body ~ast~ a."()".opright;
  return @qot @cwhile(@uqot(cond), @uqot(body));
};
while ~~ fn (a ~ast) inline {
  @cif (a."()"), { 
    cond ~ast~ a."()".opleft;
    body ~ast~ a."()".opright;
    return @qot @loop{
      @if (@uqot(cond)),
        (@uqot(body)),
        (break());
    };
  },{
    return @qot @loop{
      @if (@uqot(a)),
        (0),
        (break());
    };
  };
};
not ~~ fn (in ~bool) bool return in bxor 1;
some_state ~ @sint(32); // basically private, but copied around like lua
getstate ~~ fn () (@typeof(some_state)) // like a public accessor
  return (some_state = some_state + 1);
arr ~~ fn (i~int) any 
  return (fn (T~type) type 
    return (@arrof(i,T)));
specialize ~~ fn (call~ast) inline return @qot @specialize(@uqot(call));
array_len ~~ fn (T~type) int return @typeinfo(T).array.len;
arrcat ~~ fn (a~any, b~any) any {
    fl ~~ array_len(@typeof(a)) + array_len(@typeof(b));
    r ~ @comptime arr(fl) @typeinfo(@typeof(a)).array.elem;
    {
        i~=0;
        cwhile (i < array_len(@typeof(a))) {
            r[i] = a[i];
            i = i + 1;
        };
    };
    {
        i~=0;
        cwhile (i < array_len(@typeof(b))) {
            r[i + array_len(@typeof(a))] = b[i];
            i = i + 1;
        };
    };
    return r;
};
int_str_r ~~ fn (i~int) any {
  c ~@comptime arr(1) i8;
  c[0] = i % 10 + ("0"[0]);
  cif i / 10 {
    return arrcat(int_str_r(i / 10),c);
  } else return c;
};
int_str ~~ fn (i~int) any {
  cif i == 0 {
    return "0";
  } else cif i < 0 {
    return arrcat("-",int_str(-1 * i));
  } else return int_str_r(i);
};
error_t ~~ @struct{emsg ~ @ptrof(i8);};
error ~~ fn (msg~ast) inline {
  result ~~ @gensym(result);
  return @qot {
    @uqot(result) ~error_t;
    cif (@typeof(@uqot(msg)) == @typeof(@uqot(result).emsg)) {
      @uqot(result).emsg = @uqot(msg);
    } else {
      @uqot(result).emsg = @where (@uqot(msg))[0];
    };
    @uqot(result);
  };
};
! ~~ fn (T~type) type  return @struct{
  Self~type~@this();
  has_err ~bool;
  data ~ @union{
    err ~error_t;
    result ~T;
  };
  @id("=") ~~ fn (this ~@reft(Self) , other ~any) void {
    cif (@typeof(other) == Self) {
      this.has_err = other.has_err;
      this.data = other.data;
    } else cif (@typeof(other) == T) {
      this.has_err = false;
      this.data.result = other;
    } else cif (@typeof(other) == error_t) {
      this.has_err = true;
      this.data.err = other;
    } else @compileError();
  };
  catch ~~ fn (self ~ast, fallback ~ast) inline { 
    this ~ast~ @gensym(this);
    return @qot {
      @uqot(this) ~= @uqot(self);
      if @uqot(this).has_err 
        (@uqot(this).data.err |> (@uqot(this).data.result = @uqot(fallback)));
      @uqot(this).data.result;
    };
  };
  try ~~ fn (self ~ast) inline return @qot {
      this ~~ @uqot(self);
      if this.has_err {
        RT ~type~ @returntype();
        cif (
          @typeinfo(RT).struct and 
          (@typeinfo(RT).struct.namespace.fn.0 ==
          @typeinfo(!).fn.0)
        ) {
          error ~RT;
          error.has_err = true;
          error.data.err = this.data.err;
          return error;
        } else @compileError();
      };
      this.data.result;
  };
};
? ~~ fn (T~type) type return @struct {
    Self ~~ @this();
    isnnull  ~bool;
    value    ~T;
    @id("as") ~~ fn (this~Self , t~type) t {
      cif (t == bool) {
        return this.isnnull; 
      } else  @error(); // not bound to anything, regular unbound id
    };
    @id("=") ~~ fn (this~@reft(Self), o~any) void {
      cif (@typeof(o) == @typeof(null)) {
        this.isnnull = false;
      } else cif (@typeof(o) == Self) {
        this.isnnull = o.isnnull;
        if o.isnnull (this.value = o.value);
      } else {
        this.value = o;
        this.isnnull = true;
      };
    };
    // unwrap ~~ fn (this ~)
    orelse ~~ fn (this~ast , a~ast) inline {
      self ~ast~ @gensym(self);
      rest ~ast~ @gensym(rest);
      return @qot {
        @uqot(self) ~= @uqot(this);
        @uqot(rest) ~ @typeof(@uqot(self).value);
        if (@uqot(self)) (@uqot(rest) = @uqot(self).value)
          else (@uqot(rest) = @uqot a);
        @uqot(rest);
      };
    };
};


requires ~~ fn (cnd~@comptime(bool)) @comptime(void) 
  @cif(not(cnd), @compileError());

ceval ~~ fn (name ~ any , T~type) {
  requires(array_of(i8,@typeof(name)));
  T;
} {
  @cout "return ";
  @cout name;
  @cout ";";
};
cdo ~~ fn (name ~ any) {
  requires(array_of(i8,@typeof(name)));
  void;
} { @cout name; };

longarray ~~ fn (T~type, count~int) type {
  cif (count < 0) @compileError();
  cif (count <= ((1 shl 32) - 1)) {
    return @struct {
      Self ~~ @this();
      len ~~ count;
      data ~arr(count) T;
      get ~~ fn (self~@reft(Self), index~u64) (@reft T) {
        return @ref self.data[index];
      };
      @id("()") ~~ fn (self~ast, index~ast) inline {
        cif (not(index.ablock) or not(index.ablock[0]) or index.ablock[1])
          @compileError();
        return @qot @ref (@uqot(self)):get(@uqot(index.ablock[0]));
      };
    };
  } else {
    half ~~ (count + 1) / 2;
    Block ~~ longarray(T, half);
    return @struct {
      Self ~~ @this();
      len ~~ count;
      data ~@arrof(2, Block);
      get ~~ fn (self~@reft(Self), index~u64) (@reft T) {
        return @ref self.data[index / half]:get(index % half);
      };
      @id("()") ~~ fn (self~ast, index~ast) inline {
        cif (not(index.ablock) or not(index.ablock[0]) or index.ablock[1])
          @compileError();
        return @qot @ref (@uqot(self)):get(@uqot(index.ablock[0]));
      };
    };
  };
};

array_of ~~ fn (T~type, A~type) (@comptime bool) {
  info ~~ @typeinfo(A).array;
  cif (not info) { return false; }
  else { return info.elem == T; };
};
came_from ~~ fn (a~type ,b ~any) (@comptime bool ) {
  tia ~~ @typeinfo(a);
  tib ~~ @typeinfo(b);
  cif (not tia.struct) { return false; }
  else cif (not tib.fn) { return false; }
  else {return tia.struct.namespace.fn.0 == tib.fn.0;};
};
callable ~~ fn (signature~ast) inline {
  args ~ast~ signature."()".opleft;
  ret ~ast~ signature."()".opright;
  counter ~= 0;
  gen_arg ~~ fn (a~ast) ast {
    name ~~ @id(arrcat("arg", int_str(counter = counter + 1)));
    return @qot(@uqot(name)~@uqot(a));
  };
  arg_name ~~ fn (a~ast) ast return a.decl.name;
  params ~ast~ @apply(gen_arg, args);
  names ~ast~ @apply(arg_name, params);
  return @qot @struct {
    Self ~~ @this();
    Pointer ~~ @fnptr(@uqot(args), @uqot(ret));
    // Own the function pointer. The other union member leaves room for a
    // borrowed context without making copies point into the original wrapper.
    ctx ~@union {
      pointer ~Pointer;
      data ~@ptrof(void);
    };
    invoke ~@fnptr((@ptrof(void), @splice args), @uqot(ret));
    call_pointer ~~ @fn(
      (context~@ptrof(void), @splice params),
      @uqot(ret),
      {
        return (@at(context as @ptrof(Pointer)))(@splice names);
      }
    );
    @id("()") ~~ @fn(
      (self~@reft(Self), @splice params),
      @uqot(ret),
      {
        return self.invoke((@where self.ctx) as @ptrof(void), @splice names);
      }
    );
    @id("=") ~~ fn (self~@reft(Self), other~any) void {
      cif @typeof(other) == Self {
        self.ctx = other.ctx;
        self.invoke = other.invoke;
      } else cif @typeof(other) == Pointer {
        self.ctx.pointer = other;
        self.invoke = call_pointer;
      } else @compileError();
    };
    @id("as") ~~ fn (self~Self, target~type) Pointer {
      cif target == Pointer { return self.ctx.pointer; }
      else { @compileError(); };
    };
  };
};
@struct{
  inline  ~~ inline;
  bool  ~~ bool;
  type  ~~ type;
  ast ~~ ast ;
  any ~~ any ;
  int ~~ int;
  i8  ~~ i8;
  i16 ~~ i16;
  i32 ~~ i32;
  i64 ~~ i64;
  u8  ~~ u8;
  u16 ~~ u16;
  u32 ~~ u32;
  u64 ~~ u64;
  void  ~~ void;
  getstate ~~ getstate;
  @closure ~~ @closure;
  closure ~~ closure;
  fn ~~ fn;
  fnptr ~~ fnptr;
  if ~~ if;
  while ~~ while;
  cwhile ~~ cwhile;
  cif ~~ cif;
  arr ~~ arr;
  specialize ~~ specialize;
  callable ~~ callable;
  null ~~ null;
  ? ~~ ?;
  error_t ~~ error_t;
  error ~~ error;
  ! ~~ !;
  true  ~~ true;
  false ~~ false;
  not ~~ not;
  came_from ~~ came_from;
  array_of ~~ array_of;
  longarray ~~ longarray;

  requires ~~ requires;
  ceval ~~ ceval;
  cdo ~~ cdo;
  @ast_len ~~ @ast_len;
  int_str ~~ int_str;
  arrcat ~~arrcat ;
};
