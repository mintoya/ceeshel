@using @import @path("module.cshl");
// create example
range ~~ fn (start~i32, end~i32) any {
  result ~ @struct{
    Self  ~~ @this();
    state ~ i32;
    end   ~ i32;
    next ~~ fn (this~@reft(Self)) (? i32) {
      result ~ @returntype() = null;
      if (this.state < this.end) {
        result = this.state;
        this.state = this.state + 1;
      };
      return result;
    };
  };
  result.state = start;
  result.end   = end;
  return result;
};
// pass on example
filter ~~ fn (cnd ~ast) inline return @qot{
  rt ~ @struct{
    Self ~~ @this();
    state ~ @typeof _;
    next ~~ fn (this~@reft(Self)) any {
      result ~= this.state:next();
      while (
        ( result as bool )
        and not(result.value |> @uqot(cnd))
      ) (result = this.state:next());
      return result;
    };
  };
  rt.state = _;
  rt;
};
map ~~ fn (body ~ast) inline return @qot {
  rt ~ @struct{
    Self ~~ @this();
    state ~ @typeof _;
    next ~~ fn (this~@reft(Self)) any {
      result ~= this.state:next();
      if (result) (result.value = (result.value |> @uqot body));
      return result;
    };
  };
  rt.state = _;
  rt;
};
until ~~ fn (body ~ast) inline return @qot {
  rt ~ @struct{
    Self ~~ @this();
    state ~ @typeof _;
    next ~~ fn (this~@reft(Self)) any {
      result ~= this.state:next();
      if (not result) return null;
      if (result.value |> @uqot body) return null;
      return result;
    };
  };
  rt.state = _;
  rt;
};

// consume examples
iterate ~~ fn () inline return @qot while ((_:next()));

each ~~ fn (block~ast) inline return @qot {
  it ~= _;
  value ~@typeof(_:next());
  while (value = _:next()) 
    (value.value |>@uqot(block));
};

@struct{
  filter ~~ filter;
  map ~~ map;
  each ~~ each;
  until ~~ until;
  range ~~ range;
  iterate ~~ iterate;
};
