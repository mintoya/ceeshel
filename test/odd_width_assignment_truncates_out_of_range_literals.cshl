type ~~ @type();
u3 ~~ @uint(3);
s3 ~~ @sint(3);
u9 ~~ @uint(9);

a ~u3 = 9;
b ~s3 = 4;
c ~s3 = 7;
d ~u9 = 512;

// a literal wider than the destination keeps only the low bits; a signed
// destination re-reads the top bit as the sign
(a == 1)
  and (b == (0 - 4))
  and (c == (0 - 1))
  and (d == 0);
