type ~~ @type();
s3 ~~ @sint(3);
s7 ~~ @sint(7);
u9 ~~ @uint(9);
u65 ~~ @uint(65);

neg ~@comptime(@sint(3))~ (0 - 2);
mid ~@comptime(@sint(7))~ (0 - 5);
high ~@comptime(@uint(9))~ 500;
huge ~@comptime(@uint(65))~ 18446744073709551616;

a ~s3 = neg;
b ~s7 = mid;
c ~u9 = high;
d ~u65 = huge;

// a comptime constant of an odd width keeps its value when stored and copied
(neg == (0 - 2))
  and (mid == (0 - 5))
  and (high == 500)
  and (huge == 18446744073709551616)
  and (a == (0 - 2))
  and (b == (0 - 5))
  and (c == 500)
  and (d == huge);
