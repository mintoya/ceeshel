@using @import @path "enumlib/module.cshl";
Result ~~ !(i32);
forward ~~ fn (input~Result) Result {
  value ~i32 = input:try();
  return (value + 1) as i32;
};
a ~Result = 17 as i32;
success ~Result = forward(a);
message ~arr(4) i8 = "oops";
e ~error_t;
e.emsg = @where message[0];
a = e;
failed ~Result = forward(a);
not(success.has_err) and (success.data.result == 18) and failed.has_err and ((@at failed.data.err.emsg) == "o"[0]);
