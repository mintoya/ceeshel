@using @import @path "module.cshl";


digits ~~ int_str(12345);
empty ~~ int_str(0);
(@typeinfo(@typeof(digits)).array.len == 5)
  and (digits[0] == "1"[0])
  and (digits[1] == "2"[0])
  and (digits[2] == "3"[0])
  and (digits[3] == "4"[0])
  and (digits[4] == "5"[0])
  and (@typeinfo(@typeof(empty)).array.len == 0);
