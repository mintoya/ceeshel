// a block's value meets the destination: {...; [..]} builds the type
@using @import @path "lib/fn.cshl";
@using @import @path "lib/types.cshl";
somevalue ~ @struct {
  value ~ i32;
  __add ~~ [a~@this(),b~@this()] <<fn>> @this()
    [value ~~ (a.value + b.value)];
};
somevalue = [value ~~ 1];
somevalue = somevalue :__add somevalue;
P ~~ @struct{ x ~i32; y ~i32; };
p ~P = { n ~i32 = 3; [n, n + 1] };
(somevalue.value == 2) and (p.y == 4)
