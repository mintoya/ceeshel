tfn ~~ @fn (t~@type()),@type(),{
  return @struct{t~t;};
};
t1 ~~ tfn(@sint(8));
t2 ~~ tfn(@sint(32));

// the functio that generated t1 and t2 is the same
(@typeinfo(t1).struct.namespace.fn.0 
  == 
  @typeinfo(t2).struct.namespace.fn.0)
and 
(@typeinfo(tfn).fn.0 
  == 
  @typeinfo(t2).struct.namespace.fn.0)
and 
//but different types and different specialization
(@typeinfo(t1).struct.namespace.fn.1 
  != 
  @typeinfo(t2).struct.namespace.fn.1)
  ;
