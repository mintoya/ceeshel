@using @import @path "enumlib/module.cshl";
f ~~ fn (width~int, value~@sint(width)) (@sint(width)) return value + 1;
a ~~ specialize(f(32, 0 as i32));
b ~~ specialize(f(32, 99 as i32));
c ~~ specialize(f(8, 0 as i8));
x ~i32 = 41;
y ~i32 = 8;
(@typeinfo(a).fn.0 == @typeinfo(b).fn.0) and
(@typeinfo(a).fn.0 != @typeinfo(c).fn.0) and
(a(x) == 42) and (b(y) == 9);
