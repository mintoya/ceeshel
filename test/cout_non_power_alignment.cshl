u24 ~~ @uint(24);
s24 ~~ @sint(24);
S ~~ @struct { prefix ~@uint(8); value ~u24; negative ~s24; };
x ~S;
x.prefix = 33;
x.value = 0x123456;
x.negative = 0 - 3;
V ~~ @union { word ~u24; bytes ~@arr(4, @uint(8)); };
v ~V; v.word = 0x123456;
(v.bytes[0] == 0x56) and (v.bytes[2] == 0x12) and (@sizeof(u24) == 3) and (@alignof(u24) == 3)
  and (x.prefix == 33) and (x.value == 0x123456) and (x.negative == (0 - 3));
