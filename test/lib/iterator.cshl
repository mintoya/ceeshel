@using @import @path "types.cshl";
@using @import @path "fn.cshl";
@using @import @path "optional.cshl";

range ~~ [start ~any, end ~@typeof(start)] <<fn>> any {
  R ~~ @struct{
    Self ~~ @this();
    at ~@typeof(start);
    end ~@typeof(start);
    next ~~ [self ~@refT(Self)] <<fn>> ?(@typeof(start)) {
      r ~?(@typeof(start)) = null;
      @if[self.at < self.end, {
        r = self.at;
        self.at = self.at + 1;
      }];
      r
    };
  };
  r ~R = [start, end];
  r
};

map_on ~~ [inner ~any, f ~any] <<fn>> any {
  M ~~ @struct{
    Self ~~ @this();
    inner ~@typeof(inner);
    next ~~ [self ~@refT(Self)] <<fn>> any {
      x ~= self.inner:next();
      r ~?(@typeof(f(x.value))) = null;
      @if[x.present, r = f(x.value)];
      r
    };
  };
  r ~M = [inner];
  r
};
map ~~ [body ~ast] <<fn>> inline '(map_on(_, @fn[[_ ~@any()], @any(), `body]));

filter_on ~~ [inner ~any, f ~any] <<fn>> any {
  M ~~ @struct{
    Self ~~ @this();
    inner ~@typeof(inner);
    next ~~ [self ~@refT(Self)] <<fn>> any {
      x ~= self.inner:next();
      @loop{
        @if[x.present, @if[f(x.value), @break()], @break()];
        x = self.inner:next();
      };
      x
    };
  };
  r ~M = [inner];
  r
};
filter ~~ [body ~ast] <<fn>> inline '(filter_on(_, @fn[[_ ~@any()], @any(), `body]));

until_on ~~ [inner ~any, f ~any] <<fn>> any {
  M ~~ @struct{
    Self ~~ @this();
    inner ~@typeof(inner);
    next ~~ [self ~@refT(Self)] <<fn>> any {
      x ~= self.inner:next();
      @if[x.present, @if[f(x.value), x = null]];
      x
    };
  };
  r ~M = [inner];
  r
};
until ~~ [body ~ast] <<fn>> inline '(until_on(_, @fn[[_ ~@any()], @any(), `body]));

each ~~ [body ~ast] <<fn>> inline {
  it ~~ @gensym(it);
  x ~~ @gensym(x);
  '{
    `it ~= _;
    @loop{
      `x ~= (`it):next();
      @if[(`x).present, (`x).value |> `body, @break()];
    };
  }
};

@struct{
  range ~~ range;
  map ~~ map;
  map_on ~~ map_on;
  filter ~~ filter;
  filter_on ~~ filter_on;
  until ~~ until;
  until_on ~~ until_on;
  each ~~ each;
}
