// Iterators are values whose next method returns an optional value.
@using @import @path "types.cshl";
@using @import @path "fn.cshl";
@using @import @path "optional.cshl";

range ~~ [start ~any, end ~@typeof(start)] <<fn>> any {
  T ~~ @typeof(start);
  R ~~ @struct{
    Self ~~ @this();
    at ~T;
    end ~T;
    next ~~ [self ~@refT(Self)] <<fn>> ?(T) {
      r ~?(T) = null;
      @if[self.at < self.end, {
        r = self.at;
        self.at = self.at + (1 as T);
      }];
      r
    };
  };
  [start, end] as R
};

struct_fields ~~ [T ~type] <<fn>> @comptime(any) ([] as @struct{
  Self ~~ @this();
  at ~i32= 0 as i32;

  next ~~ [self ~@refT(Self)] <<fn>> ?(type) {
    @if[self.at >= (@countof(T) as @comptime(i32)),
      null as (?(type)),
      {
        idx ~@comptime(i32)~ self.at;
        field ~~ @struct {
          name ~~ @fieldname(T, idx as int);
          type ~~ @fieldtype(T, idx as int);
          val  ~~ @fieldval(T, idx as int);
        };
        self.at = idx + 1;
        field as (? type)
      }]
  };
});

map_on ~~ [inner ~any, f ~any] <<fn>> any {
  Inner ~~ @typeof(inner);
  M ~~ @struct{
    Self ~~ @this();
    inner ~Inner;
    next ~~ [self ~@refT(Self)] <<fn>> any {
      x ~= self.inner:next();
      r ~?(@typeof(f(x.value))) = null;
      @if[x.present, r = f(x.value)];
      r
    };
  };
  [inner] as M
};
map ~~ [body ~ast] <<fn>> inline '(map_on(_, @fn[[_ ~@any()], @any(), `body]));

filter_on ~~ [inner ~any, f ~any] <<fn>> any {
  Inner ~~ @typeof(inner);
  M ~~ @struct{
    Self ~~ @this();
    inner ~Inner;
    next ~~ [self ~@refT(Self)] <<fn>> @typeof((@fn[[it ~@refT(Inner)], @any(), it:next()])(self.inner)) {
      @loop {
        x ~= self.inner:next();
        @if[x.present, @if[f(x.value), x, @repeat()], x]
      }
    };
  };
  [inner] as M
};
filter ~~ [body ~ast] <<fn>> inline '(filter_on(_, @fn[[_ ~@any()], @bool(), `body]));

until_on ~~ [inner ~any, f ~any] <<fn>> any {
  Inner ~~ @typeof(inner);
  M ~~ @struct{
    Self ~~ @this();
    inner ~Inner;
    done ~bool;
    next ~~ [self ~@refT(Self)] <<fn>> any {
      x ~@typeof(self.inner:next()) = null;
      @if[self.done == (0 == 1), {
        x = self.inner:next();
        @if[x.present, @if[f(x.value), { self.done = 0 == 0; x = null; }]];
      }];
      x
    };
  };
  [inner, 0 == 1] as M
};
until ~~ [body ~ast] <<fn>> inline '(until_on(_, @fn[[_ ~@any()], @bool(), `body]));

// it |> each body: body runs for every element, as _, where each is written:
// it sees and changes the caller's variables
each ~~ [body ~ast] <<fn>> inline {
  it ~~ @gensym(it);
  x ~~ @gensym(x);
  '{
    `it ~= _;
    @loop {
      `x ~= (`it):next();
      @if[(`x).present, {
        (`x).value |> `body;
        @repeat()
      }]
    };
  }
};

@struct{
  range ~~ range;
  map ~~ map;
  map_on ~~ map_on;
  filter ~~ filter;
  filter_on ~~ filter_on;
  until ~~ until;
  until_on ~~ until_on;
  each ~~ each;
  struct_fields ~~ struct_fields;
}
