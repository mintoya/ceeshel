// Iterators are values whose next method returns an optional value.
@using @import @path "types.cshl";
@using @import @path "fn.cshl";
@using @import @path "optional.cshl";

range ~~ [start ~any, end ~@typeof(start)] <<fn>> any {
  T ~~ @typeof(start);
  R ~~ @struct{
    Self ~~ @this();
    at ~T;
    end ~T;
    next ~~ [self ~@refT(Self)] <<fn>> ?(T) {
      r ~?(T) = null;
      @if[self.at < self.end, {
        r = self.at;
        self.at = self.at + (1 as T);
      }];
      r
    };
  };
  [start, end] as R
};

struct_fields ~~ [T ~type] <<fn>> any ([] as @struct{
  Self ~~ @this();
  at ~int= 0;

  next ~~ [self ~@refT(Self)] <<fn>> ?(type) {
    @if[self.at >= @countof(T),
      null as (?(type)),
      {
        field ~~ @struct {
          name ~~ @fieldname(T, self.at);
          type ~~ @fieldtype(T, self.at);
          val  ~~ @fieldval(T, self.at);
        };
        self.at = self.at + 1;
        field as (? type)
      }]
  };
});

map_on ~~ [inner ~any, f ~any] <<fn>> any {
  Inner ~~ @typeof(inner);
  M ~~ @struct{
    Self ~~ @this();
    inner ~Inner;
    next ~~ [self ~@refT(Self)] <<fn>> any {
      x ~= self.inner:next();
      r ~?(@typeof(f(x.value))) = null;
      @if[x.present, r = f(x.value)];
      r
    };
  };
  [inner] as M
};
map ~~ [body ~ast] <<fn>> inline '(map_on(_, @fn[[_ ~@any()], @any(), `body]));

filter_on ~~ [inner ~any, f ~any] <<fn>> any {
  Inner ~~ @typeof(inner);
  M ~~ @struct{
    Self ~~ @this();
    inner ~Inner;
    next ~~ [self ~@refT(Self)] <<fn>> @typeof((@fn[[it ~@refT(Inner)], @any(), it:next()])(self.inner)) {
      x ~= self.inner:next();
      @if[x.present, @if[f(x.value) == (0 == 1), @recur[self]]];
      x
    };
  };
  [inner] as M
};
filter ~~ [body ~ast] <<fn>> inline '(filter_on(_, @fn[[_ ~@any()], @bool(), `body]));

until_on ~~ [inner ~any, f ~any] <<fn>> any {
  Inner ~~ @typeof(inner);
  M ~~ @struct{
    Self ~~ @this();
    inner ~Inner;
    done ~bool;
    next ~~ [self ~@refT(Self)] <<fn>> any {
      x ~@typeof(self.inner:next()) = null;
      @if[self.done == (0 == 1), {
        x = self.inner:next();
        @if[x.present, @if[f(x.value), { self.done = 0 == 0; x = null; }]];
      }];
      x
    };
  };
  [inner, 0 == 1] as M
};
until ~~ [body ~ast] <<fn>> inline '(until_on(_, @fn[[_ ~@any()], @bool(), `body]));

each_on ~~ [inner ~any, f ~any] <<fn>> void {
  it ~@typeof(inner) = inner;
  callback ~@typeof(f) = f;
  x ~= it:next();
  @if[x.present, {
    callback(x.value);
    @recur[it, callback];
  }];
};
each ~~ [callback ~ast] <<fn>> inline '(each_on(_, `callback));

@struct{
  range ~~ range;
  map ~~ map;
  map_on ~~ map_on;
  filter ~~ filter;
  filter_on ~~ filter_on;
  until ~~ until;
  until_on ~~ until_on;
  each ~~ each;
  each_on ~~ each_on;
  struct_fields ~~ struct_fields;
}
