// Iterators are values whose next method returns an optional value.
@using @import @path "types.cshl";
@using @import @path "fn.cshl";
@using @import @path "optional.cshl";

range ~~ [start ~any, end ~@typeof(start)] <<fn>> any {
  T ~~ @typeof(start);
  R ~~ @struct{
    Self ~~ @this();
    at ~T;
    end ~T;
    next ~~ [self ~@refT(Self)] <<fn>> ?(T) {
      r ~?(T) = null;
      @if[self.at < self.end, {
        r = self.at;
        self.at = self.at + (1 as T);
      }];
      r
    };
  };
  [start, end] as R
};

struct_fields ~~ [T ~type] <<fn>> @comptime(any) ([] as @struct{
  Self ~~ @this();
  at ~i32= 0 as i32;

  next ~~ [self ~@refT(Self)] <<fn>> ?(type) {
    @if[self.at >= (@countof(T) as @comptime(i32)),
      null as (?(type)),
      {
        idx ~@comptime(i32)~ self.at;
        field ~~ @struct {
          name ~~ @fieldname(T, idx as int);
          type ~~ @fieldtype(T, idx as int);
          val  ~~ @fieldval(T, idx as int);
        };
        self.at = idx + 1;
        field as (? type)
      }]
  };
});

// it |> map body, filter body, until body: iterators whose next is inline,
// so the body is expanded where next is called, in the caller's function,
// and sees the caller's variables. _ is the element inside the body.
// map: the elements through body.
map ~~ [body ~ast] <<fn>> inline {
  M ~~ @gensym(M); x ~~ @gensym(x); r ~~ @gensym(r);
  '{
    `M ~~ @struct{
      inner ~@typeof(_);
      next ~~ @fn[[self ~@ast()], @inlineast(), '{
        `x ~= (\`self).inner:next();
        _ ~= (`x).value;
        `r ~_optional(@typeof(`body)) = _null;
        @if[(`x).present, `r = `body];
        `r
      }];
    };
    [_] as `M
  }
};

// filter: only the elements for which body is true
filter ~~ [body ~ast] <<fn>> inline {
  M ~~ @gensym(M); x ~~ @gensym(x);
  '{
    `M ~~ @struct{
      inner ~@typeof(_);
      next ~~ @fn[[self ~@ast()], @inlineast(), '(@loop {
        `x ~= (\`self).inner:next();
        _ ~= (`x).value;
        @if[(`x).present, @if[`body, `x, @repeat()], `x]
      })];
    };
    [_] as `M
  }
};

// until: the elements before the first for which body is true
until ~~ [body ~ast] <<fn>> inline {
  M ~~ @gensym(M); x ~~ @gensym(x);
  '{
    `M ~~ @struct{
      inner ~@typeof(_);
      done ~@bool();
      next ~~ @fn[[self ~@ast()], @inlineast(), '{
        `x ~@typeof((\`self).inner:next()) = _null;
        @if[(\`self).done == (0 == 1), {
          `x = (\`self).inner:next();
          _ ~= (`x).value;
          @if[(`x).present, @if[`body, { (\`self).done = 0 == 0; `x = _null; }]];
        }];
        `x
      }];
    };
    [_, 0 == 1] as `M
  }
};

// it |> each body: body runs for every element, as _, where each is written:
// it sees and changes the caller's variables
each ~~ [body ~ast] <<fn>> inline {
  it ~~ @gensym(it);
  x ~~ @gensym(x);
  '{
    `it ~= _;
    @loop {
      `x ~= (`it):next();
      @if[(`x).present, {
        (`x).value |> `body;
        @repeat()
      }]
    };
  }
};

@struct{
  range ~~ range;
  map ~~ map;
  filter ~~ filter;
  until ~~ until;
  each ~~ each;
  struct_fields ~~ struct_fields;
  // what the adapters' expansions use, wherever they are expanded
  _optional ~~ ?;
  _null ~~ null;
}
