// cshl's print.cshl. print[["% is %/%", x, y]] writes the format with each %
// replaced by the next argument, through a fmt_ctx: a context pointer and a
// function given what to write. / writes the character after it as it is.
// The format is passed on as an AST, so each one has its own fmt_r, which
// walks it at compile time and leaves only the writes.
@using @import @path "types.cshl";
@using @import @path "fn.cshl";
@using @import @path "slice.cshl";
@using @import @path "iterator.cshl";
@cinclude("<stdio.h>");

fmt_ctx ~~ @struct{
  Self ~~ @this();
  ctx ~@ptr(@void());
  out ~@fnptr[[@ptr(@void()), slice(i8)], @void()];
  put ~~ [self ~Self, msg ~slice(i8)] <<fn>> @void() self.out(self.ctx, msg);
};

// v in decimal
fmt_int ~~ [ctx ~fmt_ctx, v ~i64] <<fn>> @void() {
  buf ~@arr[20, i8];
  // the magnitude as a u64, which holds the smallest i64's too
  m ~u64;
  @if[v < (0 as i64), m = (((0 as i64) - (v + (1 as i64))) as u64) + (1 as u64), m = v as u64];
  j ~u64 = 20 as u64;
  j = @fn[[buf ~@refT(@arr[20, i8]), m ~u64, j ~u64], u64, {
    next ~u64 = j - (1 as u64);
    @get[buf, next] = @get["0", 0] + ((m % (10 as u64)) as i8);
    @if[m >= (10 as u64), @recur[buf, m / (10 as u64), next]];
    next
  }](buf, m, j);
  @if[v < (0 as i64), {
    j = j - (1 as u64);
    @get[buf, j] = @get["-", 0];
  }];
  ctx:put(slice_of(buf):sub(j, 20 as u64));
};

// one argument: an integer, a string, a slice, or a value with _fmt(ctx)
fmt_one ~~ [ctx ~fmt_ctx, v ~any] <<fn>> @void() {
  @if[@compiles(fmt_int(ctx, v)), fmt_int(ctx, v),
    @if[@compiles(ctx:put(v)), ctx:put(v), {
      t ~= v;
      @if[@compiles(slice_of(t)), ctx:put(slice_of(t)), v:_fmt(ctx)];
    }]];
};

fmt_r ~~ [ctx ~fmt_ctx, format ~ast, args ~any] <<fn>> @void() {
  f ~~ `format;
  text ~= f;
  s ~= slice_of(text);
  n ~~ @countof(@typeof(f));
  // The index parameters are compile-time integers. Ordinary recursive
  // specialization expands this finite format into calls with known slices.
  walk ~~ @fn[[ctx ~fmt_ctx, s ~@typeof(s), args ~any, i ~int, start ~int, k ~int], void, {
    @if[i < n, {
      c ~~ @get[f, i];
      next ~int = i + 1;
      begin ~int = start;
      arg ~int = k;
      @if[c == @get["%", 0], {
        ctx:put(s:sub(start as u64, i as u64));
        fmt_one(ctx, @get[args, k]);
        arg = k + 1;
        begin = i + 1;
      }];
      @if[c == @get["/", 0], {
        ctx:put(s:sub(begin as u64, i as u64));
        next = i + 2;
        begin = i + 1;
      }];
      walk(ctx, s, args, next, begin, arg);
    }, {
      @if[k != @len[args], @compileError("more arguments than %")];
      ctx:put(s:sub(start as u64, n as u64));
    }];
  }];
  walk(ctx, s, args, 0, 0, 0);

};

// fmt(ctx, ["format", args...])
fmt ~~ [ctx ~ast, a ~ast] <<fn>> inline
  '(fmt_r(`ctx, `(@get[a, 1]), [..`(@get[a, 2, @len[a]])]));

putc ~~ [c ~i8] <<fn>> @void() @cexpr[@void(), "putchar(c)"];
stdout ~~ [ctx ~@ptr(@void()), msg ~slice(i8)] <<fn>> @void() (msg:iter() |> each(putc));
cfmt ~~ [] <<fn>> fmt_ctx {
  r ~fmt_ctx;
  r.out = stdout as @typeof(r.out);
  r
};

// print[["format", args...]]: fmt to stdout
print ~~ [a ~ast] <<fn>> inline
  '(fmt_r(cfmt(), `(@get[a, 1]), [..`(@get[a, 2, @len[a]])]));

@struct{
  fmt_ctx ~~ fmt_ctx;
  fmt_int ~~ fmt_int;
  fmt_one ~~ fmt_one;
  fmt_r ~~ fmt_r;
  fmt ~~ fmt;
  cfmt ~~ cfmt;
  print ~~ print;
}
