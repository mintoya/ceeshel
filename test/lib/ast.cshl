ast ~~ @ast(); any ~~ @any(); bool ~~ @bool();

is ~~ @fn[[x ~ast, name ~any], bool,
  @ast_stringeq(@get[x, 0], name)];

items ~~ @fn[[x ~ast], ast, @get[x, 1, @len[x]]];

is_list  ~~ @fn[[x ~ast], bool, is[x, "[]"]];
is_block ~~ @fn[[x ~ast], bool, is[x, "{}"]];

is_decl ~~ @fn[[x ~ast], bool, is[x, "~"] or is[x, "~="] or is[x, "~~"]];
decl_name ~~ @fn[[x ~ast], ast, @get[x, 1]];

decl_type ~~ @fn[[x ~ast], ast, {
  r ~ast;
  @if[is[x, "~"] or (@len[x] == 4),
    r = @get[x, 2]];
  r
}];

decl_value ~~ @fn[[x ~ast], ast, {
  r ~ast;
  @if[is[x, "~"],
    {},
    r = @get[x, @len[x] - 1]];
  r
}];

@struct{
  items ~~ items;
  is_list ~~ is_list;
  is_block ~~ is_block;
  is_decl ~~ is_decl;
  decl_name ~~ decl_name;
  decl_type ~~ decl_type;
  decl_value ~~ decl_value;
}
