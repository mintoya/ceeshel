@struct {
  type    ~~ @type();
  int     ~~ @int();
  ast     ~~ @ast();
  inline  ~~ @inlineast();
  any     ~~ @any();
  anyref  ~~ @refT(@any());

  void    ~~ @void();
  bool    ~~ @bool();
  sc      ~~ @schar();
  ss      ~~ @sshort();
  si      ~~ @sint();
  sl      ~~ @slong();
  uc      ~~ @uchar();
  us      ~~ @sshort();
  ui      ~~ @sint();
  ul      ~~ @slong();
  i8      ~~ @schar();
  i16     ~~ @sshort();
  i32     ~~ @sint();
  i64     ~~ @slong();
  u8      ~~ @uchar();
  u16     ~~ @ushort();
  u32     ~~ @uint();
  u64     ~~ @ulong();
  arr     ~~ @fn[[N~@int()],@any(),{
              @fn[[T~@type()],@type(),
                @arr(N,T)]}]
}
