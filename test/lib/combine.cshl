@using @import @path "fn.cshl";
//@using @import @path "ast.cshl";
type ~~ @type();
int ~~ @int();
ast ~~ @ast();
combine ~~ [a~type,b~type] <<fn>> type {
  av ~@comptime(a);
  bv ~@comptime(b);
  fields ~= '{};
  i~int=0;
  @fn[[i ~@int()], @void(), @if[i < @countof(a), {
    n ~ast~ @fieldname(a,i);
    ra ~ast = '(`n ~@typeof(av.`n));
    @if[@isconst(av.`n),
      ra = '(`n ~@typeof(av.`n)~ av.`n)];
    fields = '{..`(@get[fields,1,@len(fields)]);`ra;};
    @recur[i + 1];
  }]](i);
  i = 0;
  @fn[[i ~@int()], @void(), @if[i < @countof(b), {
    n ~ast~ @fieldname(b,i);
    ra ~ast = '(`n ~@typeof(bv.`n));
    @if[@isconst(bv.`n),
      ra = '(`n ~@typeof(bv.`n)~ bv.`n)];
    fields = '{..`(@get[fields,1,@len(fields)]);`ra;};
    @recur[i + 1];
  }]](i);
  @struct `fields
};
@struct{
  combine ~~ combine;
}
