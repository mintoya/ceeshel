@using @import @path "types.cshl";
@using @import @path "fn.cshl";

@id(".") ~~ [right ~ast, left ~ast] <<fn>> inline {
  r ~~ @gensym(r);
  '{
    `r ~@ast() = '(@raw((`right).`left));
    @if[@compiles((`right):__dot(`left)),
      `r = '((`right):__dot(`left))];
    (\`)(`r)
  }
};
@id("=") ~~ [target ~anyref, value ~any] <<fn>> @refT(@typeof(target)) @raw({
  @if[@compiles(target:__set(value)),
    target:__set(value),
    @if[@compiles(value:__as(@typeof(target))),
      target = value:__as(@typeof(target)),
      target = value]];
  target
});
@id("as") ~~ [value ~ast, T ~ast] <<fn>> inline {
  v ~~ @gensym(value);
  t ~~ @gensym(target);
  r ~~ @gensym(result);
  result ~ast = '((@fn[[`v ~@any(), `t ~@type()], `t, @raw({
      `r ~`t;
      @if[@compiles((`v):__as(`t)),
        `r = (`v):__as(`t),
        @if[@compiles((`r):__set(`v)),
          (`r):__set(`v),
          `r = `v as `t]];
      `r
    })])[`value, `T]);
  @if[@ast_stringeq(@get[value, 0], "[]"),
    result = '((@raw(`@id("as")))[`value, `T])];
  result
};

@struct {
  `@id(".") ~~ `@id(".");
  `@id("=") ~~ `@id("=");
  `@id("as") ~~ `@id("as");
}
