ifyT ~~ @fn[
  [T ~@ast(),cnd ~@ast(), a~@ast(),b~@ast()], @ast(),
  { 
  result ~~ @gensym(result);
  '{
    `result ~ `T;
    @if[`cnd,
      `result = `a,
      `result = (`b)];
    `result
}}];
ify ~~ @fn[
  [cnd~@ast(), a~@ast(),b~@ast()], @inlineast(),
    ifyT[`'@typeof(`a), `cnd, `a, `b]];
@struct{
  ifyT ~~ ifyT;
  ify ~~ ify;
}
