@using @import @path "combine.cshl";
@struct {
  Ast ~~ @import @path "ast.cshl";
  true ~@comptime(@bool())~ (1==1);
  false ~@comptime(@bool())~ (0==1);
  not ~~ @fn[[i ~@bool()], @bool(),(i == (0 == 1))];
} 
  |> combine[_,@import @path "fn.cshl"]
  |> combine[_,@import @path "ify.cshl"]
  |> combine[_,@import @path "types.cshl"]
  |> combine[_,@import @path "closure.cshl"]
  |> combine[_,@import @path "combine.cshl"]
  |> combine[_,@import @path "overloads.cshl"]
