type ~~ @type();
ast ~~ @ast();
i32 ~type~ @sint(32);

writes ~ i32;
writes = 0;

Box ~type~ @struct{
  Self ~type~ @this();
  x ~i32;
  // `=` takes both operands as asts and expands into the returned block, so the
  // right operand has to reach the overload still unlowered
  @id("=") ~~ @fn (self~ast, other~ast), @inlineast(), {
    return @qot {
      writes = writes + 1;
      @uqot(self).x = @uqot(other);
    };
  };
};

a ~Box;
a = 42;
b ~Box;
b = a.x + 1;
(a.x == 42) and (b.x == 43) and (writes == 2);
