@using @import @path "lib/iterator.cshl";
@using @import @path "lib/fn.cshl";
@using @import @path "lib/types.cshl";

x ~int= 0;

struct_fields( @struct {
  i ~int~ 2;
  j ~int~ 5;
  k ~int~ 8;
  l ~int~ 3;
}) |> each {
  @log _.name;
  @log _.type;
  @log _.val;
  x = x + _.val;
};

x == (2 + 5 + 8 + 3)
