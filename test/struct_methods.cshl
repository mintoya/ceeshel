// a:f(x) is T.f[a, x]; a reference parameter gets a itself
i32 ~~ @sint();
P ~~ @struct{
  Self ~~ @this();
  x ~i32;
  y ~i32;
  sum ~~ @fn[[self ~Self], i32, self.x + self.y];
  move ~~ @fn[[self ~@refT(Self), dx ~i32], @void(), {
    self.x = self.x + dx;
  }];
};
p ~P = ([1 as i32, 2 as i32] as P);
p:move(10 as i32);
(p:sum() == (13 as i32)) and (P.sum[p] == (13 as i32))
