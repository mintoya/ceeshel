@using @import @path "enumlib/module.cshl";
f ~~ fn (width~int, value~@sint(width)) (@sint(width)) return value;
width ~i32 = 32;
selected ~~ specialize(f(32, 0 as i32));
not(@compiles(@specialize(f))) and
not(@compiles(@specialize(f(32)))) and
not(@compiles(@specialize(f(width, 0 as i32)))) and
not(@compiles(@specialize(1(32)))) and
not(@compiles({ p ~fnptr (i8) i8 = selected; })) and
not(@compiles({ p ~fnptr (i32) i8 = selected; })) and
not(@compiles(selected(1, 2)));
