i32 ~~ @sint(32);
ast ~~ @ast();
inline ~~ @inlineast();
fn ~~ @fn (a~ast), inline, {
  return @qot @fn(@uqot(a."()".opleft),
    @uqot(a."()".opright."()".opleft),
    @uqot(a."()".opright."()".opright));
};
(@compiles(@struct {
  @id("band") ~~ fn (left~ast, right~ast) inline return @qot(1);
}) == (0 as @bool()))
and
