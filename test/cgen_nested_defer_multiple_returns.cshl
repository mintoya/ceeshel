i32 ~~ @sint(32);
seen ~i32;
f ~~ @fn((out ~@refT(i32), flag ~@bool()), i32, {
  defer { defer { out = out * 10 + @returnvalue(); }; };
  defer { out = 1; };
  @if(flag, { return 7; });
  return 9;
});
a ~i32 = f(seen, 1);
first ~i32 = seen;
b ~i32 = f(seen, 0);
(a == 7) and (first == 17) and (b == 9) and (seen == 19);
