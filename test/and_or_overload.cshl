// and/or are names like + : declaring one shadows the builtin in scope.
// With ast parameters an overload keeps the short circuit.
ast ~~ @ast(); inline ~~ @inlineast(); i32 ~~ @sint();
builtin_and ~~ and;
calls ~i32 = 0;
counted ~~ @fn[[], @bool(), { calls = calls + 1; 1 == 1 }];
x ~~ {
  and ~~ @fn[[l ~ast, r ~ast], inline, '{ calls = calls + 10; builtin_and[`(l), `(r)] }];
  (0 == 1) and counted()
};
y ~~ (0 == 1) and counted();
(x == (0 == 1)) and (y == (0 == 1)) and (calls == 10) and and[1 == 1, 2 == 2]
