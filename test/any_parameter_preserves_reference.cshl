@using(@import @path("module.cshl"));
// An `any` parameter is the generic placeholder: it must lower the argument at runtime,
// not fold it into a comptime value, or a passed reference is lost and writes go nowhere.
setit ~~ fn (r ~any) any {
  result ~ @struct { data ~ @refT @typeof r; };
  result.data = r;
  result.data = 42;
  return result;
};
x ~i32;
setit(@ref x);
x == 42;
