i32 ~~ @sint(32);
ast ~~ @ast();
inline ~~ @inlineast();
fn ~~ @fn (a~ast), inline, {
  return @qot @fn(@uqot(a."()".opleft),
    @uqot(a."()".opright."()".opleft),
    @uqot(a."()".opright."()".opright));
};
effects ~i32 = 0;
Box ~~ @struct {
  value ~i32;
  @id(".") ~~ fn (self~ast, name~ast) inline {
    return @qot {
      effects = effects + 1;
      @rawget(@uqot(self), "value") + 3;
    };
  };
};
a ~Box;
result ~= a.value;
(result == 3) and (effects == 1);
