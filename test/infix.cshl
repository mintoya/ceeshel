inline ~~ @inlineast();
ast ~~ @ast();
any ~~ @any();
type ~~ @type();

i32 ~~ @sint();

// fn[params, ret] body: the parameters and return type now, the body next
fn ~~ @fn[[params ~ast, ret ~ast], inline,
  '@fn[[body ~ast], any, @fn[
    `params,
    `ret,
    \`body]]];


([i ~i32] <<fn>> i32 i + (1 as i32))(6 as i32) == (7 as i32);

z ~~ fn[[i ~i32], i32] i * (2 as i32);
x ~~ [i ~i32] <<fn>> i32 i * (2 as i32);

((z x (5 as i32)) == (20 as i32)) and
(x[z[5 as i32]] == (20 as i32))
