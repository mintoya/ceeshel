@using @import @path "enumlib/module.cshl";
@using @import @path "enumlib/slice.cshl";
@using @import @path "enumlib/iterator.cshl";
@using @import @path "enumlib/print.cshl";

enum_validate ~~ fn (t~type) type {
  cif (@typeinfo(t.members).struct.members.len == 0) 
    @compileError();
  {
    i ~= 0;
    cwhile (i < @typeinfo(t.members).struct.members.len) {
      cif (@typeinfo(t.members).struct.members[i].name == "else")
        @compileError("else is reserved");
      i = i + 1;
    };
  };
  vt ~~ {x~t;x._value;} |> @typeof _;
  return @struct{
    _value ~vt;
    members ~~ fn (s~ast) type 
      return t.values;
    assign ~~ fn (self~@reft(@this()) ,other ~ast) void {
      n ~= @typeinfo(t.members).struct.members.len;
      cwhile (n > 0 and other != @typeinfo(t.members).struct.members[n - 1].name) {
        iname ~= @typeinfo(t.members).struct.members[n - 1].name;
        n = n - 1;
      };
      cif (n == 0) @compileError();
      iname ~= @typeinfo(t.members).struct.members[n - 1].name;
      self._value = @rawget(t.values,iname);
    };
    switch ~~ fn (self ~ast, block ~ast) inline {
      s ~ast~ @gensym(s);
      count ~= @uqot@qot@ast_len@uqot block;
      nmembers ~~ @typeinfo(t.members).struct.members.len;

      has_other ~= false;
      cif (count == 0) @compileError();
      cif (block[count - 1].op."|>".opleft == "else") { has_other = true; };

      chain ~ast;
      first ~= true;
      i ~= count;
      cwhile (i > 0) {
        arm  ~ast~ block[i - 1];
        nm   ~ast~ arm.op."|>".opleft;
        body ~ast~ arm.op."|>".opright;

        cif (nm == "else") {
          cif (not(i == count)) @compileError();   // else must be last
          chain = body;
          first = false;
        } else {
          k ~= nmembers;
          found ~= false;
          cwhile (k > 0 and not(nm == @typeinfo(t.members).struct.members[k - 1].name)) {
            k = k - 1;
          };
          found = k > 0;
          cif (not(found)) @compileError();

          // no duplicates
          j ~= i - 1;
          cwhile (j > 0) {
            cif (nm == block[j - 1].op."|>".opleft) @compileError();
            j = j - 1;
          };

          cond ~ast~ @qot(
            @uqot(s)._value ==
              (@uqot(s):members() |> @uqot(@ast_op(".", @qot(_), nm)))
          );
          cif (first) {
            chain = @qot @if(@uqot(cond), @uqot(body));
            first = false;
          } else {
            chain = @qot @if(@uqot(cond), @uqot(body), @uqot(chain));
          };
        };
        i = i - 1;
      };

      // force exaustinvness
      cif (not(has_other) and not(count == nmembers)) 
         @compileError();

      return @qot {
        @uqot(s) ~@reft(@typeof(@uqot(self)))~ @ref(@uqot(self));
        @uqot(chain);
      };
    };
    @id("=") ~~ fn (self~ast,other ~ast) inline {
      s ~ast~ @gensym(s);
      return @qot {
        @uqot(s) ~@reft(@typeof(@uqot(self)))~ @ref(@uqot(self));
        @uqot(s)._value = @uqot(s):members() |> @uqot(other);
      };
    };
  };
};
enum ~~ fn (block~ast) inline {
  b ~ast~ @gensym(b);
  // Reflection lists stored fields; typed constants belong to the namespace.
  // Keep a field schema for validation and a separate namespace of values.
  enum_member ~~ fn (in~ast) ast return @qot(
    @uqot(in.op.":".opleft)~@uqot(b));
  enum_constant ~~ fn (in~ast) ast return @qot(
    @uqot(in.op.":".opleft)~@uqot(b)~@uqot(in.op.":".opright));
  return @qot enum_validate {
    @uqot(b) ~~ @uqot(block."()".opleft);
    @struct{
      members ~~ @struct{
        @splice @apply(enum_member,block."()".opright);
      };
      values ~~ @struct{
        @splice @apply(enum_constant,block."()".opright);
      };
      _value ~@uqot(b);
    };
  };
};
x ~~ enum i16[a:0, b:1, c:2, d:3];
sone ~i32=0;
a ~x = _.b;
a:switch[
  b |> (sone = 1),
  else 
    |> (sone = 0),
];
(sone == 1) and (@sizeof(a:members()) == 0) and (@sizeof(x) == @sizeof(i16));
