// a method taking asts: the receiver arrives evaluated, once, under a name
// at the call site; the other arguments arrive as syntax
i32 ~~ @sint(); ast ~~ @ast(); inline ~~ @inlineast();
Box ~~ @struct{
  v ~i32;
  // this twice in the expansion: the receiver must still run once
  twice_plus ~~ @fn[[this ~ast, e ~ast], inline, '((`this).v + (`this).v + `e)];
  // e only expands when v is 0
  or_else ~~ @fn[[this ~ast, e ~ast], inline, '{
    r ~i32 = (`this).v;
    @if[r == (0 as i32), r = `e];
    r
  }];
};
made ~i32 = 0 as i32;
make ~~ @fn[[made ~@refT(i32), n ~i32], Box, { made = made + (1 as i32); b ~Box = ([n] as Box); b }];
used ~i32 = 0 as i32;
use ~~ @fn[[used ~@refT(i32)], i32, { used = used + (1 as i32); 7 as i32 }];
a ~= make(made, 3 as i32):twice_plus(1 as i32);
b ~= make(made, 5 as i32):or_else(use(used));
c ~= make(made, 0 as i32):or_else(use(used));
(a == (7 as i32)) and (made == (3 as i32)) and (b == (5 as i32)) and (c == (7 as i32)) and (used == (1 as i32))
