i32 ~~ @sint(32);
Node ~~ @struct {
  Self ~~ @this();
  next ~@ptr(Self);
  value ~@const(i32) = 7;
};
node ~Node;
node.next = @where(node);
copy ~~ @fn((input ~Node), Node, { return input; });
frozen ~Node~ copy(node);
Box ~~ @struct { item ~@const(Node); };
box ~Box;
values ~@arr(2, @const(i32));
(@at(node.next).value == 7) and (box.item.value == 7) and
(frozen.value == 7) and (values[0] == 0) and (values[1] == 0) and
(@compiles(node.value = 9) == 0) and (@compiles(box.item = frozen) == 0) and
(@compiles(values[0] = 3) == 0);
