@using(@import @path("module.cshl"));
// `_` is the place a pipe body writes through. Piping a reference member must not let
// `_ = other_ref` rebind the member; it has to store the value into the referenced place.
Cell ~type~ @struct {
  Self ~type~ @this();
  v ~ @refT(i32);
};
c ~Cell;
x ~i32;
y ~i32~9;
c.v = @ref x;
c.v |> { _ = y; };
x == 9;
