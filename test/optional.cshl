@using @import @path "lib/optional.cshl";
i32 ~~ @sint();
first ~~ @fn[[n ~i32], ?(i32), 
  @if[n > (0 as i32),
    n as (? i32),null as (? i32)]];
a ~= first(0 as i32);
b ~= first(5 as i32);
c ~? i32= b;
d ~? i32= 7 as i32;
calls ~i32 = 0 as i32;
anyref ~~ @refT(@any());
fallback ~~ @fn[[], i32, { calls = calls + (1 as i32); 9 as i32 }];
(a.present == (0 == 1)) and b.present and (b.value == (5 as i32))
  and (c.value == (5 as i32)) and (d.value == (7 as i32))
  and (a:orelse(fallback()) == (9 as i32)) and (b:orelse(fallback()) == (5 as i32)) and (calls == (1 as i32))
