type ~~ @type();
s8 ~~ @sint(8);
s32 ~~ @sint(32);
box ~type~ @struct{
  Self ~type~ @this();
  v ~s32;
  @id("()") ~~ @fn (self ~Self, x ~s32, y ~s32), s32, {
    return self.v + x + y;
  };
};
make ~~ @fn (), box, { b ~box; b.v = 30; return b; };
b ~box = make();
small ~s8 = 1;
tiny ~s8 = 2;
b(small, tiny) == 33;
