@using @import @path "enumlib/module.cshl";
Optional ~~ ? i32;
a ~Optional;
empty ~~ not a;
a = 17;
b ~Optional = a;
//  boolean ops should obviously convert automatically like @if
copied ~~ b and (b.value == 17);
a = null;
cleared ~~ not a;
b = a;
empty_copy ~~ not b;
a = 23;
b = a;
(empty and copied and cleared and empty_copy) and b and (b.value == 23);
