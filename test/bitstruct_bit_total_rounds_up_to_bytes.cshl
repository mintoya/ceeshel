type ~~ @type();
u8 ~~ @uint(8);

// a member of 3 bits still needs a byte to live in
one ~type~ @bitstruct{ flag ~u8:3; };
// and two members share that byte instead of taking one each
split ~type~ @bitstruct{ lo ~u8:2; hi ~u8:2; };
// a byte exactly full stays one byte
full ~type~ @bitstruct{ all ~u8:8; };

// the type is a storage type like any other, so a value of it can be declared
flags ~one;
parts ~split;
whole ~full;

(@sizeof(one) == 1)
  and (@sizeof(split) == 1)
  and (@sizeof(full) == 1);
