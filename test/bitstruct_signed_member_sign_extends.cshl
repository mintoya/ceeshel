type ~~ @type();
s8 ~~ @sint(8);

// a signed member reads back as a negative number when its top bit is set
B ~type~ @bitstruct{
  f ~s8:4;
  g ~s8:4;
};

// 0b1111 in four bits is -1 read as a signed member
a ~B;
a.f = 0b1111;
a.g = 5;

// writing a negative number stores its low bits
b ~B;
b.f = (0 - 3);
b.g = (0 - 2);

(a.f == (0 - 1))
  and (a.g == 5)
  and (b.f == (0 - 3))
  and (b.g == (0 - 2));
