ast ~~ @ast();
inline ~~ @inlineast();
read ~~ @fn((syntax ~ast), inline, { return @qot(@uqot(syntax)); });
exit ~~ @fn((syntax ~ast), inline, { return @qot { return @uqot(syntax); }; });
stop ~~ @fn((), inline, { return @qot { break(); }; });
x ~@sint(32) = 0;
@loop({
  x = x + 1;
  y ~= read(x);
  @if(y == 3, { stop(); });
});
f ~~ @fn((), @sint(32), { exit(x + 4); return 0; });
(x == 3) and (f() == 7);
